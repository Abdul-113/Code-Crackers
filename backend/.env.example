# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Firebase Credentials (JSON string or path to JSON file)
FIREBASE_CREDENTIALS_PATH=app/config/firebase-service-account.json

# AI Configuration (Groq API Key)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Blockchain Configurations
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_OWNER_PRIVATE_KEY=0x...
ESCROW_CONTRACT_ADDRESS=0x...
NFT_CONTRACT_ADDRESS=0x...

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=your-cloudinary-connection-url

# Sandbox.co.in GST Verification API Credentials
GST_API_KEY=your_sandbox_gst_api_key_here
GST_API_SECRET=your_sandbox_gst_api_secret_here
GST_API_BASE_URL=https://api.sandbox.co.in

